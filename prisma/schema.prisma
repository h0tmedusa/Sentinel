generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Scan {
  id                  String    @id @default(cuid())
  targetUrl           String
  status              String    @default("pending") // pending | running | done | failed
  authorizedConfirmed Boolean   @default(false)
  startedAt           DateTime  @default(now())
  finishedAt          DateTime?
  findings            Finding[]
}

model Finding {
  id                 String   @id @default(cuid())
  scanId             String
  checkId            String
  category           String   // session-handling | access-control | input-handling | api-config | client-config | transport-config | data-storage
  title              String
  description        String
  affectedComponent  String
  severity           String   // critical | high | medium | low
  referenceScore     String
  confidence         String   // confirmed | needs-review
  evidence           String   // JSON stringified holding actual request(s)/response(s)
  stepsToReproduce   String
  businessImpact     String
  remediation        String
  createdAt          DateTime @default(now())

  scan               Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
}
